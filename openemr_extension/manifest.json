{
  "manifest_version": 3,
  "name": "OpenEMR Medical Code Extractor",
  "version": "2.0",
  "description": "Enhanced extraction and validation of medical codes from OpenEMR doctor notes with export features",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "48": "icon.png"
  }
}
