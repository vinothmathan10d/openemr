{
  "manifest_version": 3,
  "name": "SOAP Assistant",
  "version": "2.0",
  "description": "AI-powered SOAP note generation from medical content with code extraction",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.png"
  }
}
